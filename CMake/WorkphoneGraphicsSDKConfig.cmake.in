@PACKAGE_INIT@
if(NOT WIN32 OR NOT MSVC)
    set(WorkphoneGraphicsSDK_FOUND FALSE)
    set(WorkphoneGraphicsSDK_NOT_FOUND_MESSAGE "Windows/MSVC is required")
    return()
endif()
set(WorkphoneGraphicsSDK_MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL")
set(WorkphoneGraphicsSDK_DEPENDENCIES "Windows SDK: d3d11;d3d12;dxgi;d3dcompiler;dxguid;user32;gdi32; Microsoft DLL CRT")
include("${CMAKE_CURRENT_LIST_DIR}/WorkphoneGraphicsSDKTargets.cmake")
# Do not let CMake silently substitute a Debug archive for a release CRT (or
# vice versa) when a consumer asks for a configuration not installed yet.
foreach(_wp_target Core Graphics PlatformWin32)
    set_target_properties(WorkphoneGraphics::${_wp_target} PROPERTIES
        MAP_IMPORTED_CONFIG_DEBUG Debug
        MAP_IMPORTED_CONFIG_RELWITHDEBINFO RelWithDebInfo
        MAP_IMPORTED_CONFIG_RELEASE RelWithDebInfo
        MAP_IMPORTED_CONFIG_MINSIZEREL RelWithDebInfo)
endforeach()
unset(_wp_target)
check_required_components(WorkphoneGraphicsSDK)
