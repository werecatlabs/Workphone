<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>LuaDebuggerVsix</AssemblyName>
    <RootNamespace>LuaDebuggerVsix</RootNamespace>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <CreateVsixContainer>true</CreateVsixContainer>
    <VSSDKBuildToolsAutoSetup>true</VSSDKBuildToolsAutoSetup>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>true</IncludeDebugSymbolsInVSIXContainer>
    <DeployExtension>false</DeployExtension>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="LuaDebugClient.cs;LuaDebugProtocol.cs" />
    <Reference Include="System.Design" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Web" />
    <ProjectReference Include="../LuaDebugAdapter/LuaDebugAdapter.csproj" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="BaseIntermediateOutputPath;OutputPath;RuntimeIdentifier" />
    <Content Include="AdapterRegistration.pkgdef"><IncludeInVSIX>true</IncludeInVSIX></Content>
    <Reference Include="System.Runtime.Serialization" />
    <PackageReference Include="Microsoft.VisualStudio.Sdk" Version="17.14.40265" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="18.9.820" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <VSCTCompile Include="LuaDebugger.vsct" ResourceName="Menus.ctmenu" />
    <None Update="source.extension.vsixmanifest">
      <SubType>Designer</SubType>
    </None>
  </ItemGroup>
  <Target Name="IncludeLuaDebugAdapter" BeforeTargets="GetVsixSourceItems" DependsOnTargets="ResolveProjectReferences">
    <ItemGroup>
      <VSIXSourceItem Include="$(MSBuildProjectDirectory)/../LuaDebugAdapter/bin/$(Configuration)/net48/WorkphoneLuaDebugAdapter.exe">
        <VSIXSubPath>adapter</VSIXSubPath>
      </VSIXSourceItem>
    </ItemGroup>
  </Target>
</Project>
