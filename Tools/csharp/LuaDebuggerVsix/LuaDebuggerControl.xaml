<UserControl x:Class="LuaDebuggerVsix.LuaDebuggerControl"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel Margin="12">
  <TextBlock Text="Workphone Lua Debugger" FontWeight="Bold"/>
  <TextBlock Text="Start the Editor with WP_LUA_DEBUGGER=1, then load its .workphone/lua-debug.json endpoint." TextWrapping="Wrap" Margin="0,8"/>
  <Button Content="Load Editor endpoint..." Click="LoadEndpoint_Click" HorizontalAlignment="Left"/>
  <TextBlock Text="Local debugger port" Margin="0,10,0,2"/>
  <TextBox x:Name="PortTextBox" Text="9230"/>
  <TextBlock Text="Session token" Margin="0,8,0,2"/>
  <PasswordBox x:Name="TokenTextBox"/>
  <CheckBox x:Name="StopOnEntry" Content="Stop at the next Lua line" Margin="0,10"/>
  <Button Content="Attach in Visual Studio" Click="Attach_Click" HorizontalAlignment="Left"/>
  <TextBlock Text="Use Visual Studio breakpoints, Continue, Step Into/Over/Out, Call Stack, Locals and Watch. Watch evaluation reads names and table paths without running code." TextWrapping="Wrap" Margin="0,12"/>
  <TextBlock x:Name="StatusText" TextWrapping="Wrap"/>
 </StackPanel>
</UserControl>
