<Window x:Class="fb.ModelBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:fb"
        mc:Ignorable="d"
        Title="ModelBrowserWindow" Height="450" Width="800">
    <Grid>
        <Grid Background="#FFE5E5E0">
            <Grid.Resources >
                <Style TargetType="Border" >
                    <Setter Property="Padding" Value="5,5,5,5" />
                </Style>
            </Grid.Resources>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="10*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            <Border Grid.Column="0">
                <DataGrid Name="modelObjectModels" AutoGenerateColumns="False" SelectionChanged="ModelObjectsModels_SelectionChanged" VerticalAlignment="Stretch">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Model Id" Binding="{Binding Id}" />
                        <DataGridTextColumn Header="Model Name" Binding="{Binding Name}" />
                    </DataGrid.Columns>
                    <DataGrid.RowDetailsTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Details}" Margin="10" />
                        </DataTemplate>
                    </DataGrid.RowDetailsTemplate>
                </DataGrid>
            </Border>
            <Border Grid.Column="0" Grid.Row="1">
                <Button Content="Apply" HorizontalAlignment="Right" Margin="0,0,0,0" VerticalAlignment="Top" Width="200" Click="Apply_Click"/>
            </Border>
        </Grid>
    </Grid>
</Window>
