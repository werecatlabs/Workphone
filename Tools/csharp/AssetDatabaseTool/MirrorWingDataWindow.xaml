<Window x:Class="fb.MirrorWingDataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:fb"
        mc:Ignorable="d"
        Title="MirrorWingDataWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <Border Grid.Column="0">
            <TextBox Name="SourceText" HorizontalAlignment="Center" Height="120" Margin="0,0,0,0" TextWrapping="Wrap" Text="None" VerticalAlignment="Top" Width="200"/>
        </Border>
        <Border Grid.Column="0">
            <Button Content="Select Source" HorizontalAlignment="Left" Margin="54,144,0,0" VerticalAlignment="Top" Width="200" RenderTransformOrigin="-0.165,0.817" Click="Button_Click"/>
        </Border>
        <Border Grid.Column="1" RenderTransformOrigin="0.5,0.814">
            <TextBox Name="DestinationText" HorizontalAlignment="Center" Height="120" Margin="0,0,0,0" TextWrapping="Wrap" Text="None" VerticalAlignment="Top" Width="200"/>
        </Border>
        <Border Grid.Column="1">
            <Button Content="Select Destination" HorizontalAlignment="Left" Margin="51,145,0,0" VerticalAlignment="Top" Width="200" RenderTransformOrigin="-0.165,0.817" Click="Button_Click_1"/>
        </Border>
        <Border Grid.Column="1" Grid.Row="1">
            <Button Content="Apply" HorizontalAlignment="Left" Margin="50,80,0,0" VerticalAlignment="Top" Width="200" RenderTransformOrigin="-0.165,0.817" Click="Button_Click_2"/>
        </Border>

    </Grid>
</Window>
